{
  "private": true,
  "name": "@vraj9112/jpp",
  "version": "1.0.1",
  "description": "J++ — a tiny compiled language.",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "ui"
  ],
  "main": "lib/jpp/compiler.js",
  "exports": {
    ".": "./lib/jpp/compiler.js",
    "./lexer": "./lib/jpp/lexer.js",
    "./parser": "./lib/jpp/parser.js",
    "./typeChecker": "./lib/jpp/typeChecker.js",
    "./generator": "./lib/jpp/generator.js"
  },
  "scripts": {
    "dev": "concurrently \"npm run start:ui\" \"npm run dev:lsp\"",
    "dev:lsp": "node lsp-server/server.js",
    "start:ui": "npm run dev --workspace ui",
    "build:ui": "npm run build --workspace ui",
    "test": "node --test --test-concurrency=1 tests/execute-api.test.js tests/performance.test.js"
  },
  "author": "Vraj Shah shahvraj140@gmail.com",
  "license": "MIT",
  "keywords": ["jpp", "language", "compiler"],
  "files": [
    "lib/jpp/compiler.js",
    "lib/jpp/lexer.js",
    "lib/jpp/parser.js",
    "lib/jpp/typeChecker.js",
    "lib/jpp/generator.js",
    "LICENSE"
  ],
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.1"
  }
}
