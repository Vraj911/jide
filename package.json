{
  "private": true,
  "name": "@vraj9112/jpp",
  "version": "1.0.1",
  "description": "J++ – a tiny compiled language.",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently \"npm run start:ui\" \"npm run dev:lsp\"",
    "dev:lsp": "node lsp-server/server.js",
    "start:ui": "npm --prefix ui run dev",
    "build:ui": "npm --prefix ui run build",
    "test": "node --test --test-concurrency=1 tests/auth-store.test.js tests/auth-api.test.js tests/execute-api.test.js tests/auth-integration.test.js tests/performance.test.js"
  },
  "author": "Vraj Shah shahvraj140@gmail.com",
  "license": "MIT",
  "keywords": [
    "jpp",
    "language",
    "compiler"
  ],
  "files": [
    "lib/jpp/compiler.js",
    "lib/jpp/lexer.js",
    "lib/jpp/parser.js",
    "lib/jpp/typeChecker.js",
    "lib/jpp/generator.js",
    "LICENSE"
  ],
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "sonner": "^2.0.7",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.1"
  }
}
